@page "/"
@using Maanfee.WebSocket
@implements IAsyncDisposable

<PageTitle>Chat Client: Blazor</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid Spacing="2" Class="align-center">
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_host" Label="Host" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Disabled="@(_busy || IsActive)" />
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudNumericField @bind-Value="_port" Label="Port" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 HideSpinButtons="true" Min="1" Max="65535" Disabled="@(_busy || IsActive)" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudChip T="string" @key="_state" Color="@StateColor" Variant="Variant.Filled" Size="Size.Large">@_state</MudChip>
            </MudItem>
            <MudItem xs="12" sm="3" Class="d-flex justify-end">
                @if (IsActive)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DisconnectAsync" Disabled="_busy"
                               StartIcon="@Icons.Material.Filled.LinkOff">Disconnect</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ConnectAsync" Disabled="_busy"
                               StartIcon="@Icons.Material.Filled.Link">Connect</MudButton>
                }
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        @* column-reverse keeps the scroll position pinned to the bottom, the list inside stays oldest first *@
        <div style="height: 250px; overflow-y: auto; display: flex; flex-direction: column-reverse;">
            <div>
                @if (_lines.Count == 0)
                {
                    <MudText Color="Color.Secondary">No messages yet. Connect and say hello.</MudText>
                }
                @foreach (var line in _lines)
                {
                    <MudText Color="@line.Color" Class="mb-1" Style="@(line.Kind == LineKind.Info ? "font-style: italic;" : null)">@line.Text</MudText>
                }
            </div>
        </div>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="2">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudTextField @bind-Value="_input" Label="Message" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" Disabled="@(!IsConnected)" Class="flex-grow-1"
                          OnKeyDown="OnKeyDown" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendAsync"
                       Disabled="@(!IsConnected || string.IsNullOrWhiteSpace(_input))"
                       EndIcon="@Icons.Material.Filled.Send">Send</MudButton>
        </MudStack>
        <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
            What you send is shown on the server and on the other clients as "Client: @Name: ...".
        </MudText>
    </MudPaper>

</MudContainer>

@code {
    private const string Name = "Blazor";

    private enum LineKind { Own, Server, Other, Info }

    private sealed record Line(string Text, LineKind Kind)
    {
        public Color Color => Kind switch
        {
            LineKind.Own => Color.Primary,
            LineKind.Server => Color.Secondary,
            LineKind.Info => Color.Warning,
            _ => Color.Default,
        };
    }

    private MaanfeeWebSocketClient? _client;
    private string _host = "127.0.0.1";
    private int _port = 5000;
    private string _input = string.Empty;
    private string _state = nameof(WebSocketClientState.Disconnected);
    private bool _busy;

    // oldest first; the column-reverse container keeps the view pinned to the bottom
    private readonly List<Line> _lines = new();

    private bool IsConnected => _client?.IsConnected == true;

    private bool IsActive => _client != null && _state is nameof(WebSocketClientState.Connected)
        or nameof(WebSocketClientState.Connecting) or nameof(WebSocketClientState.Reconnecting);

    private Color StateColor => _state switch
    {
        nameof(WebSocketClientState.Connected) => Color.Success,
        nameof(WebSocketClientState.Connecting) or nameof(WebSocketClientState.Reconnecting)
            or nameof(WebSocketClientState.Disconnecting) => Color.Warning,
        nameof(WebSocketClientState.Faulted) => Color.Error,
        _ => Color.Default,
    };

    private async Task ConnectAsync()
    {
        _busy = true;
        await DisposeClientAsync();

        var client = new MaanfeeWebSocketClient(new MaanfeeWebSocketClientOptions
        {
            Host = _host,
            Port = _port,
            Path = "/ws",
        });

        client.StateChanged += (_, e) => UpdateUi(() => _state = e.NewState.ToString());
        client.MessageReceived += (_, text) => UpdateUi(() => AddLine(text));
        client.ConnectionClosed += (_, reason) => UpdateUi(() => AddLine($"Connection closed: {reason}", LineKind.Info));
        client.ErrorOccurred += (_, ex) => UpdateUi(() => AddLine($"Error: {(string.IsNullOrWhiteSpace(ex.Message) ? ex.GetType().Name : ex.Message)}", LineKind.Info));
        _client = client;

        try
        {
            await client.ConnectAsync();
            AddLine($"Connected to ws://{_host}:{_port}/ws", LineKind.Info);
        }
        catch (Exception ex)
        {
            AddLine($"Could not connect: {ex.Message}", LineKind.Info);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DisconnectAsync()
    {
        _busy = true;
        try
        {
            if (_client != null)
                await _client.DisconnectAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SendAsync()
    {
        var text = _input.Trim();
        if (text.Length == 0 || _client is not { IsConnected: true })
            return;

        _input = string.Empty;

        try
        {
            // The client prefixes its own name; the server shows "Client: Blazor: ..." and relays it.
            await _client.SendTextAsync($"{Name}: {text}");
            AddLine($"Client: {Name}: {text}", LineKind.Own);
        }
        catch (Exception ex)
        {
            AddLine($"Send failed: {ex.Message}", LineKind.Info);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendAsync();
    }

    private void AddLine(string text, LineKind? kind = null)
    {
        kind ??= text.StartsWith("Server:") ? LineKind.Server : LineKind.Other;
        _lines.Add(new Line(text, kind.Value));
    }

    private void UpdateUi(Action change)
    {
        _ = InvokeAsync(() =>
        {
            change();
            StateHasChanged();
        });
    }

    private async Task DisposeClientAsync()
    {
        var client = _client;
        _client = null;
        if (client != null)
            await client.DisposeAsync();
    }

    public async ValueTask DisposeAsync() => await DisposeClientAsync();
}
