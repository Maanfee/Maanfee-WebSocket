@page "/"
@using System.Net.Http.Json
@implements IDisposable
@inject HttpClient Http

<PageTitle>Chat Server: Blazor</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudChip T="string" @key="_state" Color="@(_online ? Color.Success : Color.Error)" Variant="Variant.Filled" Size="Size.Large">
                @(_online ? _state : "Unreachable")
            </MudChip>
            <MudText>Connected clients: <b>@_clients.Count</b></MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Clients connect to ws://@(_host)/ws</MudText>
        </MudStack>

        @if (_clients.Count > 0)
        {
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-3">
                @foreach (var client in _clients)
                {
                    <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Link">
                        @client.Id[..8] <span class="ml-1 mud-text-secondary">(@client.ConnectedAt.ToLocalTime().ToString("HH:mm:ss"))</span>
                    </MudChip>
                }
            </MudStack>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        @* column-reverse keeps the scroll position pinned to the bottom, the list inside stays oldest first *@
        <div style="height: 250px; overflow-y: auto; display: flex; flex-direction: column-reverse;">
            <div>
                @if (_log.Count == 0)
                {
                    <MudText Color="Color.Secondary">No messages yet. Start a client and say hello.</MudText>
                }
                @foreach (var line in _log)
                {
                    <MudText Color="@(line.StartsWith("Server:") ? Color.Primary : Color.Default)" Class="mb-1">@line</MudText>
                }
            </div>
        </div>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="2">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudTextField @bind-Value="_input" Label="Message to all clients" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" Class="flex-grow-1" OnKeyDown="OnKeyDown" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendAsync"
                       Disabled="@(string.IsNullOrWhiteSpace(_input) || !_online)"
                       EndIcon="@Icons.Material.Filled.Send">Send</MudButton>
        </MudStack>
        <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
            Sent to every client as "Server: Blazor: ...". Messages typed by clients are relayed to the other clients.
        </MudText>
    </MudPaper>

</MudContainer>

@code {
    private sealed record ClientInfo(string Id, DateTime ConnectedAt);
    private sealed record StatusDto(string State, List<ClientInfo> Clients);

    private readonly CancellationTokenSource _cts = new();
    private List<ClientInfo> _clients = new();
    private List<string> _log = new();   // oldest first; the column-reverse container keeps the view pinned to the bottom
    private string _state = "Unknown";
    private string _host = "";
    private string _input = string.Empty;
    private bool _online;

    protected override async Task OnInitializedAsync()
    {
        _host = Http.BaseAddress!.Authority;
        await RefreshAsync();
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                await RefreshAsync();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // page left
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            var status = await Http.GetFromJsonAsync<StatusDto>("api/chat/status", _cts.Token);
            var messages = await Http.GetFromJsonAsync<List<string>>("api/chat/messages", _cts.Token);

            _state = status?.State ?? "Unknown";
            _clients = status?.Clients ?? new();
            _log = messages ?? new();
            _online = true;
        }
        catch (Exception) when (!_cts.IsCancellationRequested)
        {
            _online = false;
        }
    }

    private async Task SendAsync()
    {
        var text = _input.Trim();
        if (text.Length == 0)
            return;

        _input = string.Empty;
        await Http.PostAsJsonAsync("api/chat/send", new { message = text }, _cts.Token);
        await RefreshAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendAsync();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
